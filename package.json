{
  "name": "dsh-companion",
  "version": "1.9.5-test1",
  "private": true,
  "description": "看屏幕陪玩/陪看剧/陪写代码的 DSH 插件：自动截图 → 多模态理解 → 人格化台词（带情绪）→ 本地 TTS + RVC 语音朗读。右侧栏可开停、调参数、看记录、开新对话、直接聊天。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "services",
    "win",
    "locale",
    "icon.svg",
    "assets",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "install.ps1",
    "安装.cmd",
    "卸载.cmd"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.0-rc.1": "compatible",
        "0.1.7-rc.2": "incompatible"
      }
    }
  },
  "icon": "icon.svg"
}
