{
  "name": "@jyddwy/dsh-companion",
  "version": "1.9.6",
  "description": "看屏幕陪玩/陪看剧/陪写代码的 DSH 插件：自动截图 → 多模态理解 → 人格化台词（带情绪）→ TTS + RVC 语音朗读，支持双色桌面字幕与最多三角色陪玩。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "services",
    "win",
    "locale",
    "icon.svg",
    "assets",
    "LICENSE",
    "DISCLAIMER.md",
    "THIRD_PARTY_NOTICES.md",
    "INSTALL.md",
    "docs",
    "voice-enhancement",
    "安装RVC语音.ps1",
    "安装RVC语音.cmd"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.0-rc.1": "compatible",
        "0.1.7-rc.2": "incompatible"
      }
    }
  },
  "icon": "icon.svg",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JYDDWY/dsh-companion.git"
  },
  "homepage": "https://github.com/JYDDWY/dsh-companion#readme",
  "bugs": {
    "url": "https://github.com/JYDDWY/dsh-companion/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "companion",
    "screen",
    "tts"
  ]
}
